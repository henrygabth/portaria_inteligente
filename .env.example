# Copie para .env no computador ou configure no Render (NÃO publique o .env).
DB_HOST=seu_host_railway
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=railway
JWT_SECRET=gere_um_valor_aleatorio_longo_e_secreto
TZ_ESCOLA=America/Sao_Paulo
BREVO_API_KEY=chave_brevo_se_utilizada
EMAIL_FROM=remetente_verificado_no_brevo
# Professores recebem alertas críticos por e-mail via BREVO_API_KEY (ou SMTP já configurado).
# Para rodar o seed de DEMONSTRAÇÃO em um banco isolado:
# ALLOW_DEMO_SEED=1

# PARA TESTAR LOCALMENTE: copie este arquivo para .env e preencha as credenciais
# de um banco de testes ISOLADO (não utilize o banco real do SENAI).
MODO_TESTE_LOCAL=1
PORTA=3000
MIGRACAO_AUTOMATICA=0
AGENDADOR_ATIVO=0
# Se o MySQL de testes estiver hospedado remotamente, desbloqueie apenas com
# certeza de que NÃO é o banco de produção:
# PERMITIR_BANCO_REMOTO_TESTE=1
# Não habilite e-mails reais enquanto utilizar dados de produção:
# EMAILS_REAIS_NO_TESTE=1
