# Copie para .env no computador ou configure no Render (NÃO publique o .env).
DB_HOST=seu_host_railway
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=railway
# Conexão criptografada (obrigatória no TiDB Cloud; recomendada no Aiven):
# DB_SSL=true
JWT_SECRET=gere_um_valor_aleatorio_longo_e_secreto
TZ_ESCOLA=America/Sao_Paulo
BREVO_API_KEY=chave_brevo_se_utilizada
EMAIL_FROM=remetente_verificado_no_brevo
# Professores recebem alertas críticos por e-mail via BREVO_API_KEY (ou SMTP já configurado).
# Para rodar o seed de DEMONSTRAÇÃO em um banco isolado:
# ALLOW_DEMO_SEED=1

# ---------------- E-mail (Brevo) ----------------
# IMPORTANTE: EMAIL_FROM precisa ser de um DOMÍNIO PRÓPRIO autenticado no Brevo
# (ex.: avisos@portariainteligente.com.br). Com @gmail.com o Brevo não consegue autenticar
# e parte dos e-mails vai para o spam ou é recusada.
# EMAIL_REPLY_TO=secretaria@escola.com.br
# Secretaria e portaria recebem por e-mail só atraso/não retorno (economiza a cota diária):
# ALERTAS_EQUIPE=criticos
# Cota diária do plano (gratuito = 300). Usado só para avisar no log quando estiver perto.
# EMAIL_COTA_DIARIA=300
# Quantos e-mails a fila envia ao mesmo tempo (1 a 10).
# EMAIL_CONCORRENCIA=4

# ---------------- Servidor ----------------
# Endereço público do sistema (usado no link de redefinição de senha).
BASE_URL=https://portaria-inteligente.onrender.com
# Só preencha se o site for aberto em OUTRO domínio além deste (separados por vírgula).
# CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Notificações no celular (Web Push) — OPCIONAL
# Sem estas chaves o sistema gera um par sozinho e guarda no banco (tabela config_sistema).
# Para fixar as chaves (ex.: vários servidores), gere com:
#   node -e "console.log(require('./utils/push').gerarChavesVapid())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# E-mail de contato informado aos serviços de push (Google/Apple/Mozilla):
# PUSH_CONTATO=contato@suaescola.com.br

# Login em duas etapas (código por e-mail) — ligado para SECRETARIA, ADMIN e PORTARIA.
# DOIS_FATORES=desligado            # desliga (use só em testes)
# DOIS_FATORES_PAPEIS=SECRETARIA,ADMIN,PORTARIA,PORTEIRO,PROFESSOR   # para mudar os perfis

# Backup automático diário (madrugada). Em hospedagem com disco temporário (Render gratuito),
# baixe o backup pela tela "Saúde do Sistema" ou aponte para um disco persistente.
# BACKUP_DIR=./backups
# BACKUP_MANTER=7
# BACKUP_AUTOMATICO=desligado

# Plano grátis do Render: o servidor visita o próprio endereço a cada 10 min para não "dormir"
# (liga sozinho no Render). Para desligar: MANTER_ACORDADO=desligado
# MANTER_ACORDADO_MIN=10
