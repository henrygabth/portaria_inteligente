# APENAS NOMES/EXEMPLOS. NÃO enviar credenciais ao GitHub!
# Configure em Render > Environment.
AMBIENTE=homologacao
TZ_ESCOLA=America/Sao_Paulo
MIGRACAO_AUTOMATICA=0
AGENDADOR_ATIVO=0
EMAILS_REAIS_NO_TESTE=0
DB_HOST=host_publico_mysql_da_homologacao
DB_PORT=porta_publica_mysql_da_homologacao
DB_USER=usuario_mysql_da_homologacao
DB_PASSWORD=senha_mysql_da_homologacao
DB_NAME=banco_mysql_da_homologacao
JWT_SECRET=chave_aleatoria_exclusiva_do_ambiente
# BASE_URL opcional; Render fornece RENDER_EXTERNAL_URL automaticamente.
# Para produção somente: configure AMBIENTE=producao, AGENDADOR_ATIVO=1,
# BREVO_API_KEY e EMAIL_FROM com valores privados no painel do Render.
